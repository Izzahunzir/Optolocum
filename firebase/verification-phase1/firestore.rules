// DRAFT: isolated verification-only fixture. Merge its matches into the reviewed
// live baseline later. NEVER deploy this file as a replacement for app rules.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function admin() { return request.auth != null && request.auth.token.get('admin', false) == true; }
    function text(v) { return v is string && v.size() > 0 && v.size() <= 2000; }
    function email(v) { return text(v) && v.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$'); }
    function phone(v) { return text(v) && v.size() <= 30 && v.matches('^[+]?([ ()-]*[0-9]){7,15}[ ()-]*$'); }
    function locumFields(f) {
      return f is map && f.keys().hasAll(['fullName','email','nric','phoneNumber','gender','dateOfBirth','highestEducation','course'])
        && f.keys().hasOnly(['fullName','email','nric','phoneNumber','gender','dateOfBirth','highestEducation','course'])
        && text(f.fullName) && email(f.email) && f.nric is string && f.nric.matches('^[0-9]{6}-?[0-9]{2}-?[0-9]{4}$')
        && phone(f.phoneNumber) && text(f.gender)
        && f.dateOfBirth is string && f.dateOfBirth.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && text(f.highestEducation) && text(f.course);
    }
    function practiceFields(f) {
      return f is map && f.keys().hasAll(['practiceType','clinicName','registrationNumber','address','state','contactNumber','companyEmail'])
        && f.keys().hasOnly(['practiceType','clinicName','registrationNumber','address','state','contactNumber','companyEmail'])
        && f.practiceType in ['Hospital','Private Optical Clinic','Retail Optical Store','University/Training Institution']
        && text(f.clinicName) && text(f.registrationNumber) && text(f.address)
        && f.state in ['Johor','Kedah','Kelantan','Melaka','Negeri Sembilan','Pahang','Penang','Perak','Perlis','Sabah','Sarawak','Selangor','Terengganu']
        && phone(f.contactNumber) && email(f.companyEmail);
    }
    function document(d, uid, id) {
      return d is map && d.keys().hasAll(['path','name','contentType','size','sha256'])
        && d.keys().hasOnly(['path','name','contentType','size','sha256'])
        && d.path == 'verification_documents/' + uid + '/' + id + '/document'
        && d.name is string && d.name.size() <= 255 && !d.name.matches('.*[/\\\\].*')
        && d.contentType in ['application/pdf','image/png','image/jpeg']
        && ((d.contentType == 'application/pdf' && d.name.lower().matches('.*[.]pdf'))
          || (d.contentType == 'image/png' && d.name.lower().matches('.*[.]png'))
          || (d.contentType == 'image/jpeg' && d.name.lower().matches('.*[.](jpg|jpeg)')))
        && d.size is int && d.size > 0 && d.size <= 50 * 1024 * 1024
        && d.sha256 is string && d.sha256.matches('^[a-f0-9]{64}$');
    }
    function payload(d, uid, id) {
      return d.uid == uid && d.schemaVersion is int && d.schemaVersion == 1 && id.matches('^[a-f0-9]{40}$')
        && d.fingerprint is string && d.fingerprint.matches('^[a-f0-9]{64}$')
        && ((d.accountType == 'locum' && locumFields(d.fields) && document(d.document,uid,id))
          || (d.accountType == 'practice_owner' && practiceFields(d.fields) && !d.keys().hasAny(['document'])));
    }
    match /verification_submissions/{uid}/revisions/{id} {
      allow get, list: if owner(uid) || admin();
      allow create: if owner(uid)
        && request.resource.data.keys().hasAll(['uid','accountType','schemaVersion','fields','fingerprint','state','createdAt'])
        && request.resource.data.keys().hasOnly(['uid','accountType','schemaVersion','fields','fingerprint','document','state','createdAt'])
        && payload(request.resource.data,uid,id)
        && request.resource.data.state == 'draft'
        && request.resource.data.createdAt == request.time;
      // The only client transition. Evidence and timestamps cannot be replaced.
      allow update: if owner(uid) && resource.data.state == 'draft'
        && request.resource.data.state == 'submitted'
        && request.resource.data.submittedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state','submittedAt']);
      allow delete: if false;
    }
    match /verification_submissions/{uid} { allow read, write: if false; }
    // Phase 1 does not write approvals, roles, or management records.
    match /account_management/{uid} {
      allow get: if owner(uid) || admin();
      allow list: if admin();
      allow write: if false;
    }
  }
}
